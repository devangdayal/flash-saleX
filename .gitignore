.DS_Store
Thumbs.db
*.tmp
*.bak

# ==========================================
# Environment / Secrets
# ==========================================
.env
**/.env
*.local

# ==========================================
# Java / Maven (Nested Module Aware)
# ==========================================
**/target/
!**/src/main/**/target/
!**/src/test/**/target/
**/.mvn/wrapper/maven-wrapper.jar

# Ignore local maven wrapper executables in nested folders
**/mvnw
**/mvnw.cmd

# ==========================================
# IntelliJ IDEA
# ==========================================
.idea/
*.iws
*.iml
*.ipr
out/

# ==========================================

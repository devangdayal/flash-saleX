# ==========================================
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
**/build/
!**/src/main/**/build/
!**/src/test/**/build/

# ==========================================
# Local Log Files
# ==========================================
*.log
logs/
**/logs/